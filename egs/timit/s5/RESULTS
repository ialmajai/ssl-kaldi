#!/bin/bash
# Collect the best PER for each decode directory. Pass "dev" or "test" to
# restrict to one set, e.g.: bash RESULTS dev
for x in exp/{mono,tri,chain}*/decode* exp/chain*/*/decode*; do
  [ -d $x ] && echo $x | grep "${1:-.*}" >/dev/null && \
    grep WER $x/wer_* 2>/dev/null | utils/best_wer.sh
done
for x in exp/{mono,tri,chain}*/decode* exp/chain*/*/decode*; do
  [ -d $x ] && echo $x | grep "${1:-.*}" >/dev/null && \
    grep Sum $x/score_*/*.sys 2>/dev/null | utils/best_wer.sh
done
exit 0

# Use caution when comparing these results with other published results.
Training Set   : 3696 sentences (SA utterances excluded)
Dev Set        : 400 sentences
Test Set       : 192 sentences Core Test Set (different from Full 1680 sent. set)
Language Model : Bigram phoneme language model extracted from the training set
Phone mapping  : Training with 48 phonemes, for testing mapped to 39 phonemes
Features       : frozen SSL embeddings (see run.sh), PCA-30 for the GMM stages

