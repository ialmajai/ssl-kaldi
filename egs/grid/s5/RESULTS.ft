# base LoRA r32 layer 10 through the PCA-30 GMM / fMLLR stack (run_ft_large_fmllr.sh, TAG=lorL10)
%WER 7.51 [ 1795 / 23910, 0 ins, 0 del, 1795 sub ] exp-ft-large/lorL10/tri3b/decode_test/wer_15_0.5  # layer 10, tri3b
